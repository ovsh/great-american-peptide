# Copy this file to .env.local and fill in the keys. Every EXPO_PUBLIC_ value
# ships inside the app bundle, so put no secret here.

# RevenueCat publishable iOS SDK key. Without it the app runs with every Pro
# feature unlocked and sells nothing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# PostHog project API key. Empty means no analytics: the client is never built
# and no event leaves the phone. See docs/analytics.md.
EXPO_PUBLIC_POSTHOG_KEY=
