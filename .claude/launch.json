{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4321"],
      "port": 4321
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8084"],
      "port": 8084,
      "cwd": "mobile"
    },
    {
      "name": "expo-web-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_ROUTER_IMPORT_MODE=sync",
        "EXPO_ROUTER_IMPORT_MODE_WEB=sync",
        "npx", "expo", "start", "--web", "--port", "8092"
      ],
      "port": 8092,
      "cwd": "mobile"
    }
  ]
}
